{
  "name": "ultimate-crash",
  "version": "0.1.0",
  "homepage": "https://skylinetragedy.geeksproductionstudio.com",
  "description": "An aviation-themed React web application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test --test-force-exit",
    "generate:failure-descriptions": "node scripts/generate_failure_descriptions.js",
    "update:failure-graph": "node scripts/update_failure_graph.js",
    "apply:failure-graph": "node scripts/update_failure_graph.js --apply-approved",
    "generate:narratives": "node scripts/generate_narratives.js",
    "fetch:authoritative-sources": "NODE_TLS_REJECT_UNAUTHORIZED=0 node scripts/fetch_authoritative_sources.js",
    "process:failure-graph": "node scripts/process_failure_graph.js",
    "build:failure-pipeline": "npm run fetch:authoritative-sources && npm run process:failure-graph",
    "build:atc-phraseology": "NODE_TLS_REJECT_UNAUTHORIZED=0 node scripts/build_atc_phraseology_pipeline.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "dotenv": "^16.6.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5"
  }
}
